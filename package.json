{
  "name": "settle",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:e2e": "SETTLE_E2E=1 vitest run test/e2e",
    "seed": "tsx seed/seed.ts",
    "fixtures": "tsx scripts/record-fixtures.ts",
    "smoke:model": "tsx scripts/smoke-model.ts",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "snapshot:check": "tsx scripts/snapshot.ts --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@paypal/agent-toolkit": "1.11.0",
    "ag-grid-community": "36.3.0",
    "ai": "4.3.19",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
